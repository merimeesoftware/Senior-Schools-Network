{
  // Assets-only Worker: Next.js `output: 'export'` has no server runtime.
  // Do not set "main". A Worker script is not required for static hosting.
  // Do not set assets.run_worker_first. There is no Host-based redirect script.
  //
  // The canonical host is a Custom Domain in `routes` below. `wrangler deploy`
  // attaches it; Cloudflare manages that hostname's DNS and certificate.
  // www and any seniorschoolnetwork.* host are not Custom Domains.
  //
  // Host 301s are NOT expressed here. Workers Static Assets `_redirects`
  // does not support domain-level redirects. Configure Bulk Redirects (or
  // Single Redirects) in the dashboard. See docs/deploy-cloudflare.md.
  "name": "senior-schools-network",
  // Set when this config was added. Bump deliberately when adopting a
  // newer Workers compatibility change.
  "compatibility_date": "2026-09-26",
  // No preview URLs, per Michael's release policy (D-20261111-27).
  // Functional testing happens before merge, and merge to main goes to prod.
  "preview_urls": false,
  // Canonical origin only. Do not add www.seniorschools.org or any
  // seniorschoolnetwork.* hostname. Those stay dashboard Bulk Redirects.
  "routes": [
    { "pattern": "seniorschools.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    // Serve the static export's out/404.html for unknown paths.
    "not_found_handling": "404-page",
    // Next.js default `trailingSlash: false` emits `route.html`, not
    // `route/index.html`. This serves those files at `/route`.
    "html_handling": "auto-trailing-slash",
  },
}
