{
  // Cloudflare Workers (Static Assets) deployment for the Senior Schools Network site.
  // This serves the Next.js static export (`output: 'export'` -> ./out) as static assets.
  // There is intentionally no `main` Worker script yet: this is an assets-only Worker.
  // When dynamic behavior is needed later (e.g. a contact form + Turnstile), add a `main`
  // entrypoint here and bindings below — no platform migration required.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senior-schools-network",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./out",
    // Next.js static export emits `/philosophy.html` etc.; serve them at clean paths.
    "html_handling": "auto-trailing-slash",
    // Serve the exported 404 page for unmatched routes.
    "not_found_handling": "404-page"
  }
  // Custom domain routing (apex + www) is attached to this Worker during the domain
  // wiring step once the zone is on Cloudflare — see docs/reviews/architecture-cloudflare-review.md.
}
