# HTTP headers for the static site.
# Read by Cloudflare Workers Static Assets (and Netlify) from the deploy root.
# This file is copied from public/ into out/ at build time.
# Mirrors the previous netlify.toml headers, with a precise immutable rule for
# Next.js hashed assets under /_next/static/*.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Content-hashed build assets never change — cache them forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable
